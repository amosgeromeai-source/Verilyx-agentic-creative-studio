# Required — the n8n webhook that receives the production request.
VITE_N8N_WEBHOOK_URL=https://YOUR-N8N-DOMAIN/webhook/YOUR-PATH

# Optional — public origin of the video merger. Only needed when the backend
# returns RELATIVE video paths such as "/video/final_abc.mp4".
# Never point this at localhost for a deployed site.
# VITE_VERILYX_VIDEO_BASE_URL=https://media.your-domain.com

# Optional — job-status endpoint for polling the final video.
# Leave unset and the frontend never polls. "{jobId}" is substituted if present.
# VITE_VERILYX_STATUS_URL=https://api.your-domain.com/production/status

# Optional — sample responses at ?demo=video|rendering|video-failed|first|revised|human
# VITE_VERILYX_DEMO_MODE=true
